# OneAgent 测试专用 Docker 镜像
# 用于分布式测试的轻量级镜像

# 使用官方 Python 镜像作为基础
FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV AGENT_TYPE=${AGENT_TYPE:-"sub"}
ENV AGENT_ID=${AGENT_ID:-"agent-001"}
ENV PORT=${PORT:-8000}

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制源代码
COPY src/ /app/src/
COPY config/ /app/config/
COPY main.py /app/

# 创建日志目录
RUN mkdir -p /app/logs

# 暴露端口
EXPOSE ${PORT}

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# 启动命令
# 根据 AGENT_TYPE 决定启动方式
# 在Docker环境中使用Web服务器模式，避免CLI模式的input()问题
CMD ["sh", "-c", "uvicorn src.server.web_server:app --host 0.0.0.0 --port ${PORT}"]
